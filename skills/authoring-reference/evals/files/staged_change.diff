@@ -22,9 +22,16 @@ public sealed class ChatLogTailer : IDisposable
-    private const int ReadChunkBytes = 65536;
+    // A rotated file can grow by more than one chunk between polls, so the
+    // cap bounds a single poll rather than the whole catch-up.
+    private const int ReadChunkBytes = 8192;
+    private const int MaxChunksPerPoll = 1;

     public IReadOnlyList<string> Poll()
     {
-        return ReadToEnd();
+        return ReadBounded(ReadChunkBytes * MaxChunksPerPoll);
     }
